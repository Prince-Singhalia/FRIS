# =============================================================================
# FRIS Environment Configuration
# Copy this file to .env and fill in values. NEVER commit .env to source control.
# =============================================================================

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fris
POSTGRES_USER=fris
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# --- Backend ---
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Prefect ---
PREFECT_API_URL=http://localhost:4200/api
PREFECT_SERVER_API_HOST=0.0.0.0
PREFECT_SERVER_API_PORT=4200

# --- Provider API Keys (all optional for MVP) ---
# OpenAlex: free, no key required for basic use. Email for polite pool:
OPENALEX_EMAIL=
# Crossref: free, mailto for polite pool:
CROSSREF_MAILTO=
# ORCID Public API: requires registered client credentials
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# Semantic Scholar: optional API key for higher rate limits
SEMANTIC_SCHOLAR_API_KEY=
# IEEE Xplore: requires institutional subscription API key (disabled in MVP)
IEEE_API_KEY=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Security ---
# Admin seed password (local dev only — change in production)
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_admin_password
# JWT expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
